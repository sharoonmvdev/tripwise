#api call for creating user accoiunt
###
POST http://127.0.0.1:8000/api/register/
Content-Type: application/json

{
    "username":"react",
    "email":"react@gmail.com",
    "password":"Password@123"
}


#api call for adding a trip
###
POST http://127.0.0.1:8000/api/trips/
Content-Type: application/json
Authorization: Basic django:Password@123

{
    "title":"TVM",
    "destination":"trivandrum",
    "start_date":"2026-10-15"
}



#api call for listing trips
###
GET http://127.0.0.1:8000/api/trips/
Accept: application/json
Authorization: Basic django:Password@123



# api call for getting trip detail
###
GET http://127.0.0.1:8000/api/trips/1/
Accept: application/json
Authorization: Basic django:Password@123


# api call for adding member to trip
###
POST http://127.0.0.1:8000/api/trips/1/member/
Content-Type: application/json
Authorization: Basic django:Password@123

{
    "member":1
}








